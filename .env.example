# Copy to .env and fill in the secrets. Never commit .env.

# --- Service ---------------------------------------------------------------
APP_NAME=olist-late-delivery-api
API_PORT=8000
LOG_LEVEL=INFO

# --- Data ------------------------------------------------------------------
# Directory containing the raw Olist CSV files (host path for local runs;
# inside containers the project is mounted at /opt/airflow/project).
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=olist
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=olist
AIRFLOW_DB=airflow
MLFLOW_DB=mlflow
ENABLE_DB_LOGGING=false

# --- MLflow ----------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=olist-late-delivery
MODEL_NAME=olist-late-delivery
MODEL_STAGE=Staging
MODEL_LOCAL_PATH=artifacts/model.joblib

# --- Training --------------------------------------------------------------
RANDOM_SEED=42
TEST_SIZE=0.2
DECISION_THRESHOLD=0.5

# --- Airflow ---------------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-password
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=

# --- Monitoring ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
